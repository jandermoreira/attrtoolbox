% ATListSort: sorts the items in a list
% #1: list name
\cs_generate_variant:Nn \str_compare:nNnTF { VNVTF }
\cs_new:Npn \at_sort_list:n #1 {
    \seq_sort:cn { g_at_list_ #1 _seq } {
        \tl_set:Nn \l_tmpa_tl { ##1 }
        % \at_normalize:N \l_tmpa_tl
        \tl_set:Nn \l_tmpb_tl { ##2 }
        % \at_normalize:N \l_tmpb_tl
        \str_compare:VNVTF \l_tmpa_tl > \l_tmpb_tl {
            \sort_return_swapped:
        } {
            \sort_return_same:
        }
    }
}
\NewDocumentCommand{\ATListSort}{ m }{
    \at_sort_list:n { #1 }
}

